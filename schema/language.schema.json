{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://baboratory.com/schema/geo-grounding/language.schema.json",
  "title": "Language",
  "description": "Global language reference, keyed by ISO 639-3 code. Not country-specific — referenced from country.yaml languageUsage[].languageCode.",
  "type": "object",
  "required": ["code", "name"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "ISO 639-3 code. Primary key, must match the filename."
    },
    "name": {
      "type": "object",
      "required": ["eng", "local"],
      "additionalProperties": false,
      "properties": {
        "eng": { "type": "string" },
        "local": { "type": "string", "description": "Name of the language in the language itself." }
      }
    },
    "commonPhrases": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "e.g. { hello: ..., thankYou: ..., goodbye: ... }"
    }
  }
}
